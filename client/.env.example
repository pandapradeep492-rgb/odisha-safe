# ODISHA SAFE - Frontend environment variables (Vite)
# Copy this file to .env and adjust values as needed.

# Base URL for the backend API.
# Leave empty ("") to use the Vite dev proxy (recommended in local dev),
# or set a full URL like http://localhost:5000/api for production builds.
VITE_API_URL=/api

# Optional: override the dev proxy target used by vite.config.js
# VITE_PROXY_TARGET=http://localhost:5000
