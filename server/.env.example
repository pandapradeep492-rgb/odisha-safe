# ODISHA SAFE - Backend environment variables
# Copy this file to .env and fill in real values. NEVER commit your real .env.

# Server port
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/odisha_safe
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/odisha_safe
MONGODB_URI=mongodb://127.0.0.1:27017/odisha_safe

# JWT secret used to sign auth tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins (frontend URLs)
CLIENT_ORIGIN=http://localhost:5173

# Seed admin credentials (used by `npm run seed`)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@odishasafe.demo
SEED_ADMIN_PASSWORD=Admin@12345
