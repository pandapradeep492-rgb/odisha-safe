# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment variables (never commit real secrets)
.env
**/.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Uploads (user generated during dev)
server/uploads/*
!server/uploads/.gitkeep

# Python (optional ML service)
__pycache__/
*.pyc
.venv/
venv/

# Misc
coverage/
.cache/
